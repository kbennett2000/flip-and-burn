<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure math: no KSP or Unity references, so everything here is unit-testable on any machine.
    net48 is what the KSP plugin will reference; net10.0 is what the tests run against.
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>FlipAndBurn.Core</AssemblyName>
    <RootNamespace>FlipAndBurn.Core</RootNamespace>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
