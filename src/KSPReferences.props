<Project>
  <!-- Shared by every project here: compile against the KSP install named in local.props. Nothing is copied. -->

  <PropertyGroup>
    <!-- MechJeb2 2.15 targets .NET Framework 4.8, so we must too. KSP 1.12.5 (Unity 2019.4.18f1, Mono) loads it fine. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the .NET SDK build .NET Framework targets on Linux. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSPManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(KSPManagedDir)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(KSPManagedDir)/UnityEngine*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="MechJeb2">
      <HintPath>$(KSPDir)/GameData/MechJeb2/Plugins/MechJeb2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MechJebLib">
      <HintPath>$(KSPDir)/GameData/MechJeb2/Plugins/MechJebLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckKSPDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(KSPDir)' == ''" Text="KSPDir is not set. Copy local.props.example to local.props and set the path to your KSP install." />
    <Error Condition="!Exists('$(KSPManagedDir)/Assembly-CSharp.dll')" Text="Assembly-CSharp.dll not found in '$(KSPManagedDir)'. Check KSPDir in local.props." />
    <Error Condition="!Exists('$(KSPDir)/GameData/MechJeb2/Plugins/MechJeb2.dll')" Text="MechJeb2.dll not found under '$(KSPDir)/GameData'. Install MechJeb2 first." />
  </Target>
</Project>
